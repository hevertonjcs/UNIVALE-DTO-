		{"id":"77c2e12d16d66398","type":"text","text":"CULPA","x":220,"y":-82,"width":250,"height":60},
		{"id":"3c73780086b22a74","type":"text","text":"EVENTUAL (desvalor a vida) (não desejo mas assumi o risco do resultado)","x":-127,"y":134,"width":250,"height":85},
